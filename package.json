{
  "name": "ariadne-monorepo",
  "version": "0.1.0-alpha.24",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun tools/dev/start.ts dev",
    "dev:sandbox": "bun tools/dev/sandbox.ts",
    "start": "bun tools/dev/start.ts",
    "build": "bun run --filter @ariadne/web build",
    "icons": "bun tools/icons/generate.ts",
    "release": "go run ./tools/release",
    "release:go": "go run ./tools/release",
    "record:provider": "go run ./tools/recordprovider",
    "proto:generate": "bun tools/proto/cli.ts generate",
    "proto:check": "bun tools/proto/cli.ts check",
    "test": "bun --bun vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "check": "bun fmt --check --end-of-line=auto && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "oxlint": "1.91.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
